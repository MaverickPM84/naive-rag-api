# Copy this file to .env and fill in values as needed.
# The app runs fully offline with the defaults below — no API key required.

# --- Embeddings ---
# "fake"   → deterministic local embedder, no API key needed (default)
# "openai" → uses text-embedding-3-small; requires OPENAI_API_KEY
EMBEDDING_MODEL=fake

# --- LLM (for generating answers) ---
# "none"   → returns retrieved context directly as the answer (default)
# "openai" → uses gpt-4o-mini; requires OPENAI_API_KEY
LLM_MODEL=none

# --- OpenAI (only needed if either model above is set to "openai") ---
# OPENAI_API_KEY=sk-...

# --- Retrieval ---
TOP_K=3

# --- Storage ---
DATABASE_URL=sqlite:///./rag.db
VECTOR_STORE_PATH=vector_store.npy
